{
  "id": "dfa-no-101",
  "title": "DFA: No substring 101",
  "description": "From class minimization example (a): L = { w | w belongs to {0, 1}* and w does not contain the substring 101 }",
  "automaton": {
    "kind": "DFA",
    "states": ["q0", "q1", "q2", "q3"],
    "alphabet": ["0", "1"],
    "start": "q0",
    "accepting": ["q0", "q1", "q2"],
    "transitions": [
      { "from": "q0", "symbol": "0", "to": "q0" },
      { "from": "q0", "symbol": "1", "to": "q1" },
      { "from": "q1", "symbol": "0", "to": "q2" },
      { "from": "q1", "symbol": "1", "to": "q1" },
      { "from": "q2", "symbol": "0", "to": "q0" },
      { "from": "q2", "symbol": "1", "to": "q3" },
      { "from": "q3", "symbol": "0", "to": "q3" },
      { "from": "q3", "symbol": "1", "to": "q3" }
    ]
  },
  "testStrings": [
    { "input": "", "shouldAccept": true },
    { "input": "0", "shouldAccept": true },
    { "input": "1", "shouldAccept": true },
    { "input": "10", "shouldAccept": true },
    { "input": "101", "shouldAccept": false },
    { "input": "1101", "shouldAccept": false },
    { "input": "110", "shouldAccept": true },
    { "input": "00110", "shouldAccept": true }
  ]
}
